// Configuración de BIND9. Sustituye a /etc/bind/named.conf.options de la distribución.
// Resuelve desde la raíz (sin forwarders) solo para la red del laboratorio.

options {
    directory "/var/cache/bind";

    listen-on { any; };
    listen-on-v6 { none; };

    recursion yes;
    allow-recursion { 127.0.0.1; 192.168.50.0/24; };
    allow-query     { 127.0.0.1; 192.168.50.0/24; };
    allow-transfer  { none; };

    dnssec-validation auto;
};
